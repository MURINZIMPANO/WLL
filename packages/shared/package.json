{
  "name": "@lyriclens/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared domain contracts: provider interfaces, lyrics/subtitle codecs, feature flags, env schema.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "clean": "node -e \"require('node:fs').rmSync('coverage',{recursive:true,force:true})\""
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.4",
    "typescript": "6.0.3",
    "vitest": "^5.0.4"
  }
}
