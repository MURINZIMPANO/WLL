###############################################################################
# LyricLens — environment template
#
# Copy to `.env` (repo root). apps/api and apps/web each also accept their own
# `.env` / `.env.local`. NEVER commit a real .env — it is gitignored.
#
# Everything below marked OPTIONAL degrades gracefully: the app runs with no
# credentials at all (LRCLIB is keyless, and manual search always works). Any
# unset optional key simply disables that one adapter and the UI says so
# honestly instead of failing.
###############################################################################

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
SPEECH_PORT=4001
RENDER_PORT=4002

# Public origin of the API (used for CORS + absolute URLs).
API_PUBLIC_URL=http://localhost:4000
# Public origin of the web app.
WEB_PUBLIC_URL=http://localhost:3000

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:1420

# ---------------------------------------------------------------------------
# Database — local SQLite via libSQL (no container required)
# ---------------------------------------------------------------------------
# file:./var/lyriclens.db      -> local SQLite file (dev, default)
# libsql://...                 -> Turso / hosted libSQL
# postgres://...               -> hosted Postgres (schema is portable; see README)
DATABASE_URL=file:./var/lyriclens.db
DATABASE_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Storage — local filesystem in dev, S3/R2 in production (same interface)
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
# Only used when STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=lyriclens
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Encrypts uploaded media at rest (AES-256-GCM). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave empty in dev; MUST be set in production or uploads are stored in plaintext.
MEDIA_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomUUID()+'.'+require('crypto').randomUUID())"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
COOKIE_DOMAIN=
COOKIE_SECURE=false

# OAuth — register an app at the URL shown, then paste client id/secret here.
# Google:  https://console.cloud.google.com/apis/credentials
# Spotify: https://developer.spotify.com/dashboard
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must match a Redirect URI registered in each provider dashboard.
OAUTH_REDIRECT_URL=http://localhost:4000/v1/auth/callback

# ---------------------------------------------------------------------------
# Lyrics / music providers
# ---------------------------------------------------------------------------
# LRCLIB (https://lrclib.net) — keyless, provider of record for synced lyrics.
LRCLIB_BASE_URL=https://lrclib.net/api
LRCLIB_USER_AGENT=LyricLens/0.0.0 (https://github.com/lyriclens)

# Musixmatch — optional; requires a commercial licence. Leave empty unless you
# have one. See docs/PROVIDERS.md for the licensing note.
MUSIXMATCH_APP_ID=
MUSIXMATCH_APP_SECRET=

# Spotify Web API. Create an app in the Spotify developer dashboard.
# Requires the "user-read-currently-playing" and "user-read-playback-state"
# scopes. Only Premium accounts can use the Web Playback SDK.
SPOTIFY_WEB_PLAYBACK_ENABLED=false

# Song recognition (mic -> fingerprint -> match). Optional.
# AudD:   https://dashboard.audd.io        (free tier available)
# ACRCloud: https://www.acrcloud.com/developers-console
SONG_RECOGNITION_PROVIDER=audd
AUDD_API_TOKEN=
ACRCLOUD_API_KEY=
ACRCLOUD_API_SECRET=

# Cover art fallback for manual search (no key required, be polite with rate).
MUSICBRAINZ_USER_AGENT=LyricLens/0.0.0 (https://github.com/lyriclens)

# ---------------------------------------------------------------------------
# Subtitles / video
# ---------------------------------------------------------------------------
# OpenSubtitles: https://www.opensubtitles.com/en/consumers (free "REST API"
# key). Only needed if you want to search the public subtitle database.
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# Max upload size in megabytes.
MAX_UPLOAD_MB=2048

# ---------------------------------------------------------------------------
# Speech service (services/speech, FastAPI + faster-whisper)
# ---------------------------------------------------------------------------
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=

# ---------------------------------------------------------------------------
# Translation / explanation / exercise generation (LLM)
# ---------------------------------------------------------------------------
# Any OpenAI-compatible endpoint works (Ollama, LM Studio, OpenAI, Groq, ...).
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=llama3.1:8b

# ---------------------------------------------------------------------------
# Text to speech (pronunciation practice)
# ---------------------------------------------------------------------------
# Piper (https://github.com/rhasspy/piper) runs locally; cloud TTS also works.
TTS_PROVIDER=piper
PIPER_BINARY_PATH=
PIPER_MODEL_PATH=
TTS_CLOUD_API_KEY=

# ---------------------------------------------------------------------------
# Web Push (VAPID) — generate a key pair with:
#   npx web-push generate-vapid-keys
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LOG_LEVEL=info
# pino-pretty in dev, plain JSON in production.
LOG_PRETTY=true
