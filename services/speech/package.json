{
  "name": "@lyriclens/speech",
  "version": "0.1.0",
  "private": true,
  "description": "Transcription, alignment and pronunciation scoring (FastAPI + faster-whisper).",
  "scripts": {
    "bootstrap": "py -3 bootstrap.py --tier core",
    "bootstrap:ml": "py -3 bootstrap.py --tier ml",
    "dev": "node dev.mjs",
    "start": "node dev.mjs",
    "check": ".venv\\Scripts\\python.exe -c \"import app.main; print('speech service imports cleanly')\"",
    "clean": "node -e \"const{rmSync}=require('node:fs');for(const p of ['.venv','__pycache__','app/__pycache__'])rmSync(p,{recursive:true,force:true})\""
  }
}
