{
  "name": "@lyriclens/render",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FFmpeg-backed lyric scene rendering (PNG cards, lyric video export).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "probe": "tsx src/probe.ts",
    "clean": "node -e \"const{rmSync}=require('node:fs');for(const p of ['dist','coverage'])rmSync(p,{recursive:true,force:true})\""
  },
  "dependencies": {
    "@lyriclens/shared": "workspace:*",
    "dotenv": "^18.0.7",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.0.4"
  }
}
