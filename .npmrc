# LyricLens — pnpm settings
#
# node-linker=hoisted is REQUIRED on this machine. Windows Developer Mode is
# off, so creating symlinks fails with EPERM without administrator rights.
# The hoisted layout builds a flat node_modules and hardlinks package files
# from the content-addressable store, so disk usage stays deduped.
node-linker=hoisted

auto-install-peers=true
strict-peer-dependencies=false
link-workspace-packages=true
prefer-workspace-packages=true
# Deterministic, lockfile-driven installs in CI.
save-exact=false
