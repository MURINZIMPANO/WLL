{
  "name": "@lyriclens/web",
  "version": "0.1.0",
  "private": true,
  "description": "LyricLens web app / installable PWA.",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "node -e \"const{rmSync}=require('node:fs');for(const p of ['.next','out'])rmSync(p,{recursive:true,force:true})\""
  },
  "dependencies": {
    "@lyriclens/shared": "workspace:*",
    "@lyriclens/sync-engine": "workspace:*",
    "@lyriclens/ui": "workspace:*",
    "clsx": "^2.1.1",
    "lucide-react": "^1.57.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3"
  }
}
